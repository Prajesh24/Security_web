# ── Server ──────────────────────────────────────────────────────────────────
PORT=6060
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/gadgethub

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Use long, random secrets in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_me_to_a_long_random_secret_in_production
# CW2 baseline: access token must last at least 15 days.
JWT_EXPIRES_IN=15d

# ── Security policy ──────────────────────────────────────────────────────────
# Account lockout: lock after MAX_LOGIN_ATTEMPTS failures for LOCK_MINUTES.
# CW2 baseline: threshold in the 10–15 range.
MAX_LOGIN_ATTEMPTS=10
LOCK_MINUTES=15
# bcrypt cost factor (higher = slower = harder to brute force).
BCRYPT_ROUNDS=12
# Reject the last N passwords on change (reuse prevention) and force a
# rotation after PASSWORD_MAX_AGE_DAYS.
PASSWORD_HISTORY=5
PASSWORD_MAX_AGE_DAYS=90

# ── Encryption ───────────────────────────────────────────────────────────────
# 256-bit key material for AES-256-GCM at-rest encryption (TOTP secrets, etc.).
# Generate with `openssl rand -hex 32`. Store in a secrets manager in prod.
ENCRYPTION_KEY=change_me_to_a_long_random_encryption_key

# ── Network access control ───────────────────────────────────────────────────
# Comma-separated IPs. If ALLOWLIST is non-empty, ONLY those IPs may reach the
# API (deny-by-default). BLOCKLIST IPs are always rejected.
IP_ALLOWLIST=
IP_BLOCKLIST=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Extra browser origins allowed to call the API (CLIENT_URL is always allowed).
# The literal "null" origin is never accepted.
CORS_ALLOWLIST=

# ── Outbound requests (SSRF allowlist) ───────────────────────────────────────
# Comma-separated hostnames the server may make outbound HTTP(S) calls to.
# Empty = deny all. Used by utils/safeFetch.ts.
OUTBOUND_HOST_ALLOWLIST=

# ── OAuth 2.0 (Google) ───────────────────────────────────────────────────────
# Create a Web OAuth client in Google Cloud Console and set the redirect URI to
# GOOGLE_REDIRECT_URI below. Leave blank to disable "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:6060/api/auth/oauth/google/callback
